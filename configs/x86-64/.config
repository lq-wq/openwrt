# 目标系统
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_x86_64_Generic_DEVICE_generic=y

# 基础镜像格式
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=y

# 分区大小
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 语言和时区
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_SYSTEM_ZONEINFO_Asia=y

# 基础网络工具
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y

# 流量卸载与加速
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-offload=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_shortcut-fe=y
CONFIG_PACKAGE_shortcut-fe-cm=y
CONFIG_PACKAGE_kmod-nf-flowtable=y

# BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 网卡驱动
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-forcedeth=y
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-vmxnet3=y

# IRQ 平衡
CONFIG_PACKAGE_irqbalance=y

# 核心插件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_adguardhome_core=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-nikki=y

# 在线固件更新
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_attendedsysupgrade=y

# UPNP 端口转发
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y

# iStore 应用商店
CONFIG_PACKAGE_luci-app-store=y

# Docker 管理
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_luci-lib-docker=y

# OpenAppFilter
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y

# TTYD
CONFIG_PACKAGE_luci-app-ttyd=y

# 编译优化
CONFIG_USE_MTD=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mtune=generic"
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG=n
