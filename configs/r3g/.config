# 目标系统
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

# 内核版本
CONFIG_LINUX_6_6=y
CONFIG_LINUX_KERNEL_VERSION="6.6.*"

# 镜像格式
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256

# 语言和时区
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_SYSTEM_ZONEINFO_Asia=y

# 基础网络工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y

# 流量卸载（R3G 硬件支持）
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-offload=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_shortcut-fe=y
CONFIG_PACKAGE_shortcut-fe-cm=y

# BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 无线驱动
CONFIG_PACKAGE_kmod-mt7603e=y
CONFIG_PACKAGE_kmod-mt76x2e=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_hostapd-openssl=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_iwinfo=y

# 核心插件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-nikki=y

# OpenAppFilter
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y

# TTYD
CONFIG_PACKAGE_luci-app-ttyd=y

# 编译优化
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mtune=1004kc"
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG=n
